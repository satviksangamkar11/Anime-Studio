  "references": [
    {
      "title": "Krishna Subdues the Serpent Kaliya in the Yamuna River: Illustration from a Bhagavata Purana Series (Met)",
      "url": "https://www.metmuseum.org/art/collection/search/74677",
      "shows": "Pahari (Guler or Kangra) ink and wash, Bhagavata Purana series. From search snippet only: attribution follower of Nainsukh, ca. 1780.",
      "status": "UNVERIFIED (fetch returned HTTP 429 twice; facts from the search snippet, not from the page)"
    },
    {
      "title": "Krishna Quells the Serpent Kaliya, from a Bhagavata Purana (Cleveland Museum of Art, 2018.141)",
      "url": "https://www.clevelandart.org/art/2018.141",
      "shows": "Mewar, c. 1710, gum tempera and gold on paper. Krishna dances on the many heads in a poisoned pool, serpent-tailed women flank him, onlookers on a yellow shore, figures leaping from a tree and a cliff, the royal residence at lower right.",
      "status": "opened"
    },
    {
      "title": "Krishna Quells the Serpent Kaliya, from a Bhagavata Purana (Cleveland Museum of Art, 314446)",
      "url": "https://www.clevelandart.org/art/314446",
      "shows": "Same object record as 2018.141 (title, c. 1710, Mewar, scene description): used for the flat-colour and pool-composition notes.",
      "status": "opened"
    },
    {
      "title": "Toei Animation corporate page: production process (planning, production, editing)",
      "url": "https://corp.toei-anim.co.jp/en/company/animation_production.html",
      "shows": "Three stages: planning (theme, audience, structure, character and item design, setting, script), production (storyboarding, key animation, colours, in-betweens, backgrounds, CG and effects; about 3,000-4,500 drawings per TV episode), editing (sound, BGM, sequencing). Used for the pipeline order only.",
      "status": "opened"
    },
    {
      "title": "Narthaki: Abhinaya and bhava (classical Indian acting)",
      "url": "https://narthaki.com/info/articles/art436.html",
      "shows": "Abhinaya is the acting that makes an emotion felt; bhava divided into sthayi (eight), vyabhicari (33 transitory states, e.g. nirveda, glani, sanka), sattvika (eight involuntary states, e.g. stambham, swedam, romancam); eight rasas of the Natyashastra. The article does not name the eight sthayi bhavas.",
      "status": "opened"
    },
    {
      "title": "imp-art.org: bhava article",
      "url": "https://imp-art.org/article/bhava/",
      "shows": "Expected to cover the same bhava categories; the fetch returned HTTP 403.",
      "status": "UNVERIFIED (not read)"
    },
    {
      "title": "Natyashastra eight sthayi bhavas (rati, hasa, shoka, krodha, utsaha, bhaya, jugupsa, vismaya)",
      "url": "none",
      "shows": "The names used in acting_library.py come from general knowledge of the Natyashastra list, not from a source opened in this run.",
      "status": "UNVERIFIED (check against a primary translation before use)"
    },
    {
      "title": "Bhagavata Purana Canto 10, Chapter 16 (ŚB 10.16)",
      "url": "none (source text as given in stories/kaliya_mardan/SOURCE.md)",
      "shows": "The canon for every CANON event (EVENT-001 to EVENT-015).",
      "status": "taken from the owner's SOURCE.md; not re-checked in this run"
    }
