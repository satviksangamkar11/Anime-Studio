{
  "version": "1.2",
  "fps": 24,
  "delivery": {"codec": "libx264", "crf": 16, "pix_fmt": "yuv420p",
               "colorspace": "bt709",
               "color_primaries": "bt709", "color_trc": "bt709",
               "color_range": "tv",
               "audio": {"codec": "aac", "bitrate": "192k", "lufs": -16.0,
                         "true_peak_db": -1.5}},
  "safe_zone_frac": {"top": 0.14, "bottom": 0.35, "right": 0.111,
                     "caption_band": [0.50, 0.65]},
  "safe_zone_templates": {
    "reels": {"top": 0.14, "bottom": 0.35, "right": 0.111, "caption_band": [0.50, 0.65]},
    "shorts": {"top": 0.14, "bottom": 0.32, "right": 0.12, "caption_band": [0.52, 0.68]},
    "youtube": {"top": 0.05, "bottom": 0.10, "right": 0.05, "caption_band": [0.80, 0.92]}},
  "captions": {"max_words": 6},
  "retention": {"first_motion_s": 0.5, "first_face_change_s": 1.0,
                "hook_caption_max_words": 6,
                "no_hold_before_s": 3.0, "static_warn_s": 3.5,
                "static_fail_s": 4.0,
                "rehook_window_frac": [0.45, 0.60], "end_hook_s": 2.0,
                "captions_required": true,
                "caption_min_on_screen_s": 1.2, "caption_min_contrast": 7.0},
  "impact": {"window_s": 30, "max_frames_per_window": 4,
             "max_frames_per_entry": 4, "min_gap_frames": 12},
  "flash": {"max_flashes_per_s": 3, "min_rel_luma_change": 0.10,
            "darker_below": 0.80,
            "area_frac": 0.25, "red_flash": true,
            "red_ratio_min": 0.8, "red_min_luma": 0.05},
  "gates": {"g1_de2000_max": 6, "g2_luma_step_max": 0.04,
            "g2_drift_de2000_max": 6,
            "g3_cut_jump_de2000_max": 8, "loop_seam_de2000_max": 10,
            "shot_match_clamp_de": 3, "sat_avg_ceiling": null},
  "sound_sync": {"enabled": false}
}
