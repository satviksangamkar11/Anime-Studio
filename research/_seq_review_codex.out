"""Final reel builder (backend): rendered clips + per-shot voice tracks -> one finished reel per language, WITHOUT music.

  1. cuts: h3.assemble_reel.build_ffmpeg_assembly_plan trims every clip to its editorial window (head/tail handles removed) and concatenates
     video and the clips' own H3 sound effects; ffmpeg runs it -> <out>/<reel>_video.mp4
  2. gate: h3.gate_d_audio.plan_language_outputs checks every language (VO fit, captions, hook, closing). Findings whose code is in WAIVED are
     the writer's script-level retention rules (narration density, dead air between scripted lines) and the closing-shot anchor/mouth rule;
     the owner ordered the finished reel, so they are WRITTEN INTO THE REPORT (never hidden) and do not stop the build. Any other error stops it.
  3. mix + captions: the same Gate D functions the planner uses (SFX stem ducked under the voice stem, loudnorm to core delivery loudness,
     burned .ass captions in the language's script) -> <out>/export/<reel>_<lang>.mp4, then the AAC loudness is measured and checked.
No music is mixed (bgm_manifest None); the score is a later step. Never calls a model or ElevenLabs.

  python build_final_reel.py --pack <pack dir> --story <h3_story.json> --clips <clips.json {SHOT-001: path}> --vo <vo root with <lang>/<SHOT>.wav> --out <dir> [--reel kalika_reel1] [--langs en,hi,mr]
"""
from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent))

from core import caption_text as ct  # noqa: E402
from core.captions import ass_time  # noqa: E402
from core.style_pack import load_core  # noqa: E402
from h3 import assemble_reel as ar  # noqa: E402
from h3 import gate_d_audio as gd  # noqa: E402

WAIVED = {"NARRATION_COVERAGE_LOW", "NARRATION_WORDS_LOW", "DEAD_AIR_PAUSE", "CLOSING_NO_ANCHOR_PAYOFF", "CLOSING_MOUTH_OPEN"}


def probe_frames(path):
    r = subprocess.run(["ffprobe", "-v", "error", "-count_frames", "-select_streams", "v:0", "-show_entries", "stream=nb_read_frames",
                        "-of", "csv=p=0", str(path)], capture_output=True, text=True)
    return int(r.stdout.strip())


def assemble_video(h3_shots, clips, out_video, work):
    """Run the editorial cut plan. Returns the plan (frames, duration, seams)."""
    plan = ar.build_ffmpeg_assembly_plan(h3_shots, str(out_video))
    paths = [str(clips[s["shot_id"]]) for s in h3_shots]
    for s, p in zip(h3_shots, paths):
        need = s["timing_and_lattice"]["trim_out_frame"]
        got = probe_frames(p)
        if got < need:
            raise ValueError(f"{s['shot_id']}: clip has {got} frames, the cut needs {need}")
    work.mkdir(parents=True, exist_ok=True)
    (work / "filter.txt").write_text(plan["filter_complex"], encoding="utf-8", newline="\n")
    d = load_core()["delivery"]
    argv = ["ffmpeg", "-y", "-v", "error"]
    for p in paths:
        argv += ["-i", p]
    argv += ["-filter_complex_script", str(work / "filter.txt"), "-map", "[vout]", "-map", "[aout]", "-r", str(plan["fps"]),
             "-c:v", d["codec"], "-crf", str(d["crf"]), "-pix_fmt", d["pix_fmt"], "-colorspace", d["colorspace"], "-color_primaries",
             d["color_primaries"], "-color_trc", d["color_trc"], "-color_range", d["color_range"],
             "-c:a", d["audio"]["codec"], "-b:a", d["audio"]["bitrate"], "-movflags", "+faststart", str(out_video)]
    subprocess.run(argv, check=True)
    return plan


def mux_argv(rows, lang, vo_dir, video, export, ass, fonts_dir):
    """The planner's own mix and mux, built directly so a waived finding does not block it (same functions, same order)."""
    inputs, vo_refs, offsets, t = [str(video)], [], [], 0.0
    for r in rows:
        ed = float(r["editorial_duration_sec"])
        offsets.append(t)
        t += ed
        p = Path(vo_dir) / lang / f"{r['id']}.wav"
        if p.is_file():
            inputs.append(str(p))
            vo_refs.append((len(inputs) - 1, ed))
        else:
            vo_refs.append((None, ed))
    sfx = [{"input_index": f"h3s{k}", "trim_in_sec": o, "trim_out_sec": o + float(r["editorial_duration_sec"])} for k, (r, o) in enumerate(zip(rows, offsets))]
    mix = ";".join([gd.build_sfx_split_filter(0, len(rows)), gd.build_vo_stem_filter(vo_refs), gd.build_mix_filter(sfx, "vo_full", None, t)])
    return gd.build_final_mux_argv(video, inputs[1:], mix, export, burn_captions=True, ass_path=ass, fonts_dir=fonts_dir), t


# Caption spec v2 (research/CAPTION_SPEC_v2_REELS_SHORTS_2026-11-09.md). The family is the font file's own name (name ID 1):
# plain "Mukta" made libass draw a system font. Burned with the ass filter + shaping=complex (conjuncts join).
CAPTION_FONT = "Mukta ExtraBold"
CAPTION_FONT_FILE = "Mukta-ExtraBold.ttf"
PLAY_W, PLAY_H = 1080, 1920
CAPTION_SIZE = {"en": 112, "hi": 104, "mr": 104}
CAPTION_MAX_W = 840                         # max text width in px (safe zone x 90-930 with the outline)
CAPTION_POS = (510, 1290)                   # \an5 centre; x 510 is 30 px left of centre to clear the right button rail
CARD_WORDS = {"en": 4, "hi": 3, "mr": 3}
CARD_CHARS = {"en": None, "hi": 18, "mr": 18}
GREEN_BGR, WHITE_BGR = "&H004EFF3C&", "&H00FFFFFF&"   # ASS colours are BGR: active word green #3CFF4E, the rest white
CAPTION_PACK = {"typography": {"subtitle_latin": CAPTION_FONT, "subtitle_devanagari": CAPTION_FONT, "min_px_at_1080w": 60}}
# Owner spelling check 2026-11-09 (caption text only; the voice files and FINAL_TEXT_v2.json are NOT changed): (line id, lang) -> (old, new)
CAPTION_FIXES = {("SHOT-003-D1", "hi"): ("����?�_�_�1��?", "����?�_�_�1��?�,"), ("SHOT-010-D1", "hi"): ("�-�����?", "�-�������?")}


def caption_fits(font_file, lang):
    """Card test for split_cards: the card wraps into at most 2 lines at CAPTION_MAX_W with the real font."""
    size = CAPTION_SIZE[lang]

    def fits(card):
        return len(ct.wrap_lines(card, str(font_file), size, CAPTION_MAX_W, 2)[0]) <= 2
    return fits


def split_cards(text, lang="en", fits=None):
    """Balanced cards inside the spec limits: en at most 4 words, hi/mr at most 3 words and 18 characters, and `fits` (2 lines
    at 840 px) when given. Sentence ends are cut first. A punctuation-only token (a stray " .") joins the word before it."""
    text = re.sub(r"\s+([.,;:!?��])", r"\1", " ".join(text.split()))
    toks = []
    for t in text.split(" "):
        if toks and not re.search(r"\w", t):
            toks[-1] += t
        else:
            toks.append(t)
    sents = [s for s in re.split(r"(?<=[.?!��])\s+", " ".join(toks).strip()) if s]
    limit, max_chars = CARD_WORDS[lang], CARD_CHARS[lang]

    def ok(ws):
        s = " ".join(ws)
        return (max_chars is None or len(s) <= max_chars) and (fits is None or fits(s))
    cards = []
    for s in sents:
        words = s.split()
        for n in range(-(-len(words) // limit), len(words) + 1):      # fewest balanced cards that pass the limits
            size = -(-len(words) // n)
            chunks = [words[i:i + size] for i in range(0, len(words), size)]
            if all(ok(c) for c in chunks):
                break
        cards += chunks
    return cards


def word_cues(text, t0, t1, lang="en", fits=None):
    """Cue dicts for one spoken line: spec-v2 cards, time shared by letters, each word aligned inside its card (letters-proportional)."""
    cards = split_cards(text, lang, fits)
    weights = [sum(len(w) for w in c) + len(c) for c in cards]
    total, cues, cur = float(sum(weights)), [], t0
    for c, wt in zip(cards, weights):
        end = cur + (t1 - t0) * wt / total
        lw = [len(w) + 0.5 for w in c]
        s, words = cur, []
        for w, x in zip(c, lw):
            e = s + (end - cur) * x / sum(lw)
            words.append({"text": w, "t0": round(s, 3), "t1": round(e, 3), "conf": 1.0})
            s = e
        cues.append({"t0": round(cur, 3), "t1": round(end, 3), "text": " ".join(c), "words": words, "kind": "spoken"})
        cur = end
    return cues


def spoken_cues_real(rows, report, lang, font_file=None):
    """Caption cues from the REAL packed voice timings (vo_tracks_report.json of the language) and the line text of shots.json.
    CAPTION_FIXES change the caption text only (same word count, so the timing is unchanged)."""
    offsets, t = {}, 0.0
    for r in rows:
        offsets[r["id"]] = t
        t += float(r["editorial_duration_sec"])
    text = {}
    for r in rows:
        a = r["audio_and_dialogue_track"]
        n = (a.get("narration_by_lang") or {}).get(lang) or {}
        if n.get("text"):
            text[f"{r['id']}-N"] = n["text"]
        for k, d in enumerate((a.get("dialogue_by_lang") or {}).get(lang) or [], 1):
            text[f"{r['id']}-D{k}"] = d["text"]
    for (line_id, lg), (old, new) in CAPTION_FIXES.items():
        if lg == lang and line_id in text:
            text[line_id] = text[line_id].replace(old, new)
    fits = caption_fits(font_file, lang) if font_file else None
    cues = []
    for sh in report:
        if sh["lang"] != lang:
            continue
        for ln in sh["lines"]:
            cues += word_cues(text[ln["id"]], offsets[sh["shot"]] + ln["start"], offsets[sh["shot"]] + ln["end"], lang, fits)
    return sorted(cues, key=lambda c: c["t0"])


def caption_ass(cues, lang, fonts_dir):
    """Spec v2 ASS text, PlayRes 1080x1920. One event per spoken word: the card shows in white and the word being spoken is green
    #3CFF4E with a 108% pop on that word only. Lines are a balanced wrap at 840 px with the real font. Each card's words must
    be aligned (cue["words"], from word_cues)."""
    font = Path(fonts_dir) / CAPTION_FONT_FILE
    size = CAPTION_SIZE[lang]
    x, y = CAPTION_POS
    asc, desc = ct._font(str(font), size).getmetrics()
    line_h = asc + desc                                    # one line of the real font, px
    lines = [
        "[Script Info]", "ScriptType: v4.00+", f"PlayResX: {PLAY_W}", f"PlayResY: {PLAY_H}", "WrapStyle: 2",
        "ScaledBorderAndShadow: yes", "", "[V4+ Styles]",
        "Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, "
        "StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding",
        # outline 9 px black, shadow 4 px at 60% opacity (alpha 0x66), no box (BorderStyle 1)
        f"Style: Cap,{CAPTION_FONT},{size},{WHITE_BGR},&H000000FF&,&H00000000&,&H66000000&,0,0,0,0,100,100,0,0,1,9,4,5,0,0,0,1",
        "", "[Events]", "Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text",
    ]
    for cue in cues:
        ws = cue["words"]
        texts = [w["text"] for w in ws]
        wrapped, _ = ct.wrap_lines(" ".join(texts), str(font), size, CAPTION_MAX_W, 2)
        counts = [len(ln.split(" ")) for ln in wrapped]
        if sum(counts) != len(texts):
            raise ValueError(f"card {' '.join(texts)!r} cannot be wrapped without breaking a word")
        # a 2-line card moves its centre up by half a line, so its bottom line stays at y (inside the safe zone)
        cy = y - round((len(counts) - 1) * line_h / 2)
        for i, w in enumerate(ws):
            end = ws[i + 1]["t0"] if i + 1 < len(ws) else cue["t1"]
            body, k = [], 0
            for n in counts:
                seg = []
                for j in range(k, k + n):
                    word = texts[j]
                    seg.append("{\\1c%s\\fscx108\\fscy108}%s{\\1c%s\\fscx100\\fscy100}" % (GREEN_BGR, word, WHITE_BGR)
                               if j == i else word)
                body.append(" ".join(seg))
                k += n
            lines.append(f"Dialogue: 0,{ass_time(w['t0'])},{ass_time(end)},Cap,,0,0,0,,{{\\an5\\pos({x},{cy})}}" + "\\N".join(body))
    return "\n".join(lines) + "\n"


def measure(export):
    text = subprocess.run(gd.build_loudness_verify_argv(str(export)), capture_output=True, text=True).stderr
    return gd.check_post_aac_loudness(text)


def correct_loudness(export, loud, tries=2):
    """One-pass loudnorm is only approximate. Measure the real AAC file, apply the exact gain and a true-peak limiter to the AUDIO only
    (video stream copied), re-measure, repeat up to `tries` times. Returns the last measurement."""
    audio = load_core()["delivery"]["audio"]
    for k in range(tries):
        if loud["ok"]:
            break
        # AAC re-encoding overshoots the sample-peak limiter (reel 1 v4 hi: -0.6 dBTP after 2 tries): 0.5 dB more margin per try
        limit = round(10 ** ((audio["loudnorm_tp_db"] - 0.5 * (k + 1)) / 20), 4)
        gain = audio["lufs"] - loud["stats"]["integrated_lufs"]
        tmp = Path(str(export) + ".fix.mp4")
        subprocess.run(["ffmpeg", "-y", "-v", "error", "-i", str(export), "-c:v", "copy", "-af", f"volume={gain:.2f}dB,alimiter=limit={limit}:level=disabled",
                        "-c:a", audio["codec"], "-b:a", audio["bitrate"], "-ar", "48000", "-ac", "2", "-movflags", "+faststart", str(tmp)], check=True)
        tmp.replace(export)
        loud = measure(export)
    return loud


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--pack", required=True)
    ap.add_argument("--story", required=True)
    ap.add_argument("--clips", required=True)
    ap.add_argument("--vo", required=True)
    ap.add_argument("--out", required=True)
    ap.add_argument("--reel", default="kalika_reel1")
    ap.add_argument("--langs", default="en,hi,mr")
    ap.add_argument("--fonts", default=str(HERE.parent / "styles" / "fonts"))
    ap.add_argument("--title-cards", action="store_true", help="burn the writer's title cards instead of the spoken words (old behaviour)")
    a = ap.parse_args(argv)
    out = Path(a.out)
    (out / "export").mkdir(parents=True, exist_ok=True)
    (out / "captions").mkdir(parents=True, exist_ok=True)
    from editorial_by_lang import apply_rows, apply_shots, load
    ext = load(a.pack)                                  # <pack>/editorial_by_lang.json; missing = the v3 lengths
    rows = apply_rows(json.loads((Path(a.pack) / "shots.json").read_text(encoding="utf-8")), ext)
    story = json.loads(Path(a.story).read_text(encoding="utf-8"))
    h3_shots = apply_shots(story["episodes"][0]["shots"], ext)
    if [r["id"] for r in rows] != [s["shot_id"] for s in h3_shots]:
        raise SystemExit("pack rows and H3 story shots differ in id or order")
    clips = json.loads(Path(a.clips).read_text(encoding="utf-8"))
    video = out / f"{a.reel}_video.mp4"
    plan = assemble_video(h3_shots, clips, video, out / "assembly")
    langs = a.langs.split(",")
    res = gd.plan_language_outputs(a.reel, langs, a.vo, None, shots=rows, video_path=str(video), video_has_audio=True, burn_captions=True,
                                   captions_dir=str(out / "captions"), export_dir=str(out / "export"), fonts_dir=a.fonts,
                                   voice_engines={lg: "elevenlabs" for lg in langs})
    report = {"reel": a.reel, "video": str(video), "frames": plan["total_frames"], "seconds": plan["total_duration_sec"], "languages": {}}
    stop = False
    for lg in langs:
        rep, lp = res["reports"][lg], res["languages"][lg]
        waived = [e for e in rep["errors"] if e["code"] in WAIVED]
        blocking = [e for e in rep["errors"] if e["code"] not in WAIVED]
        entry = {"waived_findings": waived, "blocking_errors": blocking, "warnings": rep["warnings"]}
        report["languages"][lg] = entry
        if blocking:
            stop = True
            continue
        ass = out / "captions" / f"{a.reel}_{lg}.ass"
        report_path = Path(a.vo) / "vo_tracks_report.json"      # one report for all languages (build_vo_tracks --out <vo>)
        if not report_path.is_file():
            report_path = Path(a.vo).parent / f"vo_{lg}" / "vo_tracks_report.json"
        if a.title_cards or not report_path.is_file():
            cues = lp["captions"]                       # the writer's title cards (old behaviour, only on request)
        else:
            cues = spoken_cues_real(rows, json.loads(report_path.read_text(encoding="utf-8")), lg, Path(a.fonts) / CAPTION_FONT_FILE)   # captions = the spoken words
        for msg in gd.script_problems(cues, lg) if hasattr(gd, "script_problems") else []:
            raise SystemExit(f"{lg}: {msg}")
        ass_text, entries = gd.build_captions(cues, lang=lg, pack=CAPTION_PACK, fonts_dir=a.fonts)
        fails = [e["message"] for e in entries if e["level"] == "FAIL"]
        if fails:
            raise SystemExit(f"{lg} captions: " + "; ".join(fails))
        ass.write_text(ass_text if cues is lp["captions"] else caption_ass(cues, lg, a.fonts), encoding="utf-8", newline="\n")
        from core import caption_export as cx
        entry["caption_warnings"] = sorted({e["message"] for e in entries if e["level"] == "WARN"})[:6]
        entry["captions"] = {"cues": len(cues), "mode": "title cards" if cues is lp["captions"] else "spoken words"}
        cx.write_sidecars({lg: cues}, str(out / "captions"), a.reel)
        export = out / "export" / f"{a.reel}_{lg}.mp4"
        argv_, total = mux_argv(rows, lg, a.vo, video, export, ass, a.fonts)
        subprocess.run(argv_, check=True, cwd=str(HERE.parent))
        loud = correct_loudness(export, measure(export))
        entry.update(export=str(export), seconds=round(total, 2), loudness=loud["stats"], loudness_ok=loud["ok"], loudness_errors=loud["errors"])
    (out / f"{a.reel}_build_report.json").write_text(json.dumps(report, indent=1, ensure_ascii=False), encoding="utf-8")
    for lg, e in report["languages"].items():
        print(lg, "BLOCKED" if e["blocking_errors"] else "built", "| waived:", sorted({w["code"] for w in e["waived_findings"]}),
              "| loudness ok:", e.get("loudness_ok"), "|", e.get("export", ""))
        for b in e["blocking_errors"]:
            print("  BLOCK", b["code"], b["where"], str(b["message"])[:160])
    return 1 if stop else 0


if __name__ == "__main__":
    sys.exit(main())
"""Build the per-shot voice tracks the Gate D plan expects: <vo_dir>/<lang>/<SHOT-nnn>.wav, one file per shot with speech, exactly the
shot's EDITORIAL length (the reel cuts every shot at editorial_duration_sec, the clip tail is trimmed away), mono 44.1 kHz 16-bit.

Every line of a shot is placed at its scripted start (a dialogue line keeps the mouth-sync time); a line that would overlap the one before
starts GAP seconds after it. One speed-up (atempo, 1.00 to MAX_TEMPO) is applied to the whole shot, the smallest that makes the last line end
TAIL seconds before the cut; if even MAX_TEMPO does not fit, the shot is reported as a problem (the text must be shortened), never cut.
The accepted mp3/wav files are never modified. Never calls ElevenLabs or any model.

  python build_vo_tracks.py --pack <pack dir> --raw <dir with <line>.<lang>.wav, edge silence trimmed, no tempo> --out <vo_dir> [--langs en,hi,mr]
"""
from __future__ import annotations

import argparse
import json
import math
import subprocess
import sys
import wave
from pathlib import Path

GAP = 0.12
TAIL = 0.10
MAX_TEMPO = 1.15


def wav_seconds(path):
    with wave.open(str(path), "rb") as w:
        return w.getnframes() / w.getframerate()


def pack_shot(lines, editorial, gap=GAP, tail=TAIL, max_tempo=MAX_TEMPO):
    """lines = [{"id", "start", "natural"}] (scripted start and natural length in seconds). Returns (tempo, [{"id", "start", "length", "end"}]).
    Raises ValueError when no tempo up to max_tempo makes every line end before editorial - tail."""
    order = sorted(lines, key=lambda x: x["start"])
    limit = editorial - tail
    t = 1.0
    while t <= max_tempo + 1e-9:
        cur, placed = None, []
        for ln in order:
            s = ln["start"] if cur is None else max(ln["start"], cur + gap)
            length = ln["natural"] / t
            placed.append({"id": ln["id"], "start": round(s, 3), "length": round(length, 3), "end": round(s + length, 3)})
            cur = s + length
        if cur <= limit:
            return round(t, 2), placed
        t += 0.01
    raise ValueError(f"does not fit: needs more than tempo {max_tempo} ({sum(x['natural'] for x in order):.2f} s of speech in {editorial:.1f} s)")


def scripted_lines(row, lang):
    """[(line id, start)] of one pack row in one language: narration and every dialogue line."""
    a = row["audio_and_dialogue_track"]
    out = []
    n = (a.get("narration_by_lang") or {}).get(lang) or {}
    if n.get("text"):
        out.append((f"{row['id']}-N", float(n["time_range"][0])))
    for k, d in enumerate((a.get("dialogue_by_lang") or {}).get(lang) or [], 1):
        out.append((f"{row['id']}-D{k}", float(d["time_range"][0])))
    return out


def render_shot(placed, tempo, raw_dir, lang, editorial, out_path):
    """One wav of exactly `editorial` seconds: each line sped up by `tempo`, delayed to its start, mixed (no normalisation)."""
    args = ["ffmpeg", "-y", "-v", "error"]
    chains = []
    for i, p in enumerate(placed):
        args += ["-i", str(Path(raw_dir) / f"{p['id']}.{lang}.wav")]
        ms = int(round(p["start"] * 1000))
        chains.append(f"[{i}:a]atempo={tempo:.3f},adelay={ms}|{ms}[a{i}]")
    mix = "".join(f"[a{i}]" for i in range(len(placed)))
    # Gate D wants every VO file to end TAIL seconds before the cut (it pads each shot's VO to the cut itself). Floored to the ms: with a
    # frame-based editorial (8.2917 s) the exact value rounds up by a sample and Gate D reported VO_OVERFLOW_ERROR.
    end = math.floor((editorial - TAIL) * 1000) / 1000
    chains.append(f"{mix}amix=inputs={len(placed)}:normalize=0:duration=longest,apad=whole_dur={end:.3f},atrim=0:{end:.3f}[o]")
    args += ["-filter_complex", ";".join(chains), "-map", "[o]", "-ac", "1", "-ar", "44100", "-sample_fmt", "s16", str(out_path)]
    subprocess.run(args, check=True)


def build(pack, raw_dir, out_dir, langs):
    from editorial_by_lang import apply_rows, load   # lazy: that module imports this one
    rows = apply_rows(json.loads((Path(pack) / "shots.json").read_text(encoding="utf-8")), load(pack))   # no file = v3 lengths
    report, problems = [], []
    root = raw_dir
    for lang in langs:
        raw_dir = Path(root) / lang if (Path(root) / lang).is_dir() else root    # <raw>/<lang>/ or one flat folder
        for row in rows:
            sl = scripted_lines(row, lang)
            if not sl:
                continue
            ed = float(row["editorial_duration_sec"])
            lines = [{"id": i, "start": s, "natural": wav_seconds(Path(raw_dir) / f"{i}.{lang}.wav")} for i, s in sl]
            try:
                tempo, placed = pack_shot(lines, ed)
            except ValueError as e:
                problems.append(f"{row['id']} {lang}: {e}")
                continue
            dst = Path(out_dir) / lang / f"{row['id']}.wav"
            dst.parent.mkdir(parents=True, exist_ok=True)
            render_shot(placed, tempo, raw_dir, lang, ed, dst)
            report.append({"shot": row["id"], "lang": lang, "editorial": ed, "tempo": tempo, "lines": placed, "file": str(dst)})
    return report, problems


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--pack", required=True)
    ap.add_argument("--raw", required=True)
    ap.add_argument("--out", required=True)
    ap.add_argument("--langs", default="en,hi,mr")
    a = ap.parse_args(argv)
    report, problems = build(a.pack, a.raw, a.out, a.langs.split(","))
    Path(a.out, "vo_tracks_report.json").write_text(json.dumps(report, indent=1, ensure_ascii=False), encoding="utf-8")
    print(len(report), "tracks written;", len(problems), "problems")
    for p in problems:
        print("PROBLEM:", p)
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
"""Per-language editorial lengths (music session decisions, 2026-11-09): the file `<pack>/editorial_by_lang.json`.

ONE shared timeline: every language gets the same values (one video, 3 audio tracks, one score). A shot grows only by frames the clip
already has (spare tail; the last shot may only grow at its START); nothing is regenerated. Missing file = the v3 build, unchanged.

  {"fps": 24, "by_lang": {"en": {"SHOT-005": {"extend_frames": 12, "at": "end"}, ...}, "hi": {...same...}, "mr": {...same...}}}

Plan (writes the file): for each shot, the largest need of all languages = the length at which the voice plays at natural speed and ends
TAIL s before the cut; extra time rounded UP to whole beats for the shots given in --beats (BPM), not rounded for the others; capped by the
clip's spare frames; when rounding up does not fit, round DOWN and accept a voice speed-up of at most 1.03 (else reported).

  python editorial_by_lang.py --pack <pack> --story <h3_story.json> --raw <root with <lang>/<line>.<lang>.wav> --langs en,hi,mr
         --beats SHOT-003:128,SHOT-004:128,SHOT-006:176,SHOT-007:176,SHOT-008:176 [--write]
"""
from __future__ import annotations

import argparse
import copy
import json
import math
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
from build_vo_tracks import TAIL, pack_shot, scripted_lines, wav_seconds  # noqa: E402

FILE = "editorial_by_lang.json"
MAX_SPEEDUP = 1.03


def load(pack):
    """The shared per-shot extensions {shot: (frames, at)}, or {} when the file is missing. Languages must agree (one timeline)."""
    p = Path(pack) / FILE
    if not p.is_file():
        return {}
    doc = json.loads(p.read_text(encoding="utf-8"))
    langs = list(doc["by_lang"].values())
    if any(x != langs[0] for x in langs):
        raise ValueError(f"{p}: languages differ; only one shared timeline is supported")
    return {s: (int(v["extend_frames"]), v.get("at", "end")) for s, v in langs[0].items() if int(v["extend_frames"])}


def apply_rows(rows, ext, fps=24):
    out = copy.deepcopy(rows)
    for r in out:
        if r["id"] in ext:
            r["editorial_duration_sec"] = round(float(r["editorial_duration_sec"]) + ext[r["id"]][0] / fps, 4)
    return out


def apply_shots(h3_shots, ext):
    """New trim window, editorial length and master-reel windows of the H3 shots (copies)."""
    out, cum = copy.deepcopy(h3_shots), 0
    for s in out:
        t = s["timing_and_lattice"]
        n, at = ext.get(s["shot_id"], (0, "end"))
        fps = t["fps"]
        if at == "start":
            if n > t["trim_in_frame"]:
                raise ValueError(f"{s['shot_id']}: needs {n} head frames, clip has {t['trim_in_frame']}")
            t["trim_in_frame"] -= n
        else:
            if t["trim_out_frame"] + n > t["pixel_frames"]:
                raise ValueError(f"{s['shot_id']}: needs {n} tail frames, clip has {t['pixel_frames'] - t['trim_out_frame']}")
            t["trim_out_frame"] += n
        t["editorial_frames"] = t["trim_out_frame"] - t["trim_in_frame"]
        t["editorial_duration_sec"] = round(t["editorial_frames"] / fps, 4)
        t["trim_in_sec"], t["trim_out_sec"] = round(t["trim_in_frame"] / fps, 4), round(t["trim_out_frame"] / fps, 4)
        t["master_reel_frame_window"] = [cum, cum + t["editorial_frames"]]
        t["master_reel_window_sec"] = [round(cum / fps, 4), round((cum + t["editorial_frames"]) / fps, 4)]
        cum += t["editorial_frames"]
    return out


def needed_sec(lines, tempo):
    """Shot length at which these lines, packed at exactly `tempo`, end TAIL s before the cut."""
    sped = [dict(x, natural=x["natural"] / tempo) for x in lines]
    _, placed = pack_shot(sped, 1e9, max_tempo=1.0)
    return max(p["end"] for p in placed) + TAIL


def plan_shot(need1, need_max, editorial, spare, fps, beat=None):
    """Frames to add. need1 = length for natural speed, need_max = length at MAX_SPEEDUP. Returns (frames, note)."""
    raw = need1 - editorial
    if raw <= 1e-9:
        return 0, "fits at natural speed"
    if beat:
        frames = round(math.ceil(raw / beat - 1e-9) * beat * fps)
        if frames <= spare:
            return frames, f"rounded up to {round(frames / fps / beat)} beat(s)"
        frames = int(math.floor(spare / fps / beat) * beat * fps)
        note = f"rounded down to {round(frames / fps / beat)} beat(s) (spare {spare} fr)"
    else:
        frames = math.ceil(raw * fps - 1e-9)
        if frames <= spare:
            return frames, "natural speed, not rounded"
        frames, note = spare, f"all spare frames ({spare})"
    if editorial + frames / fps + 1e-9 < need_max:
        note += f"; VOICE STILL ABOVE {MAX_SPEEDUP}x"
    return frames, note


def plan(rows, h3_shots, raw_root, langs, beats_bpm):
    shots = {s["shot_id"]: s["timing_and_lattice"] for s in h3_shots}
    out, report = {}, []
    for i, r in enumerate(rows):
        sid, t = r["id"], shots[r["id"]]
        fps, ed = t["fps"], float(r["editorial_duration_sec"])
        last = i == len(rows) - 1
        need1 = need_max = 0.0
        for lg in langs:
            sl = scripted_lines(r, lg)
            if sl:
                lines = [{"id": k, "start": s, "natural": wav_seconds(Path(raw_root) / lg / f"{k}.{lg}.wav")} for k, s in sl]
                need1, need_max = max(need1, needed_sec(lines, 1.0)), max(need_max, needed_sec(lines, MAX_SPEEDUP))
        tail = t["pixel_frames"] - t["trim_out_frame"]
        # the last shot grows only at its START (owner/music rule); voice keeps its picture sync there, so a head extension gives the
        # voice no room: the last shot is planned with no spare when its tail is empty
        spare = tail if not last or tail else 0
        bpm = beats_bpm.get(sid)
        frames, note = plan_shot(need1, need_max, ed, spare, fps, 60.0 / bpm if bpm else None)
        at = "start" if last and not tail else "end"
        out[sid] = {"extend_frames": frames, "at": at}
        report.append({"shot": sid, "editorial_sec": ed, "need_natural_sec": round(need1, 3), "need_1.03_sec": round(need_max, 3),
                       "spare_frames": spare, "bpm": bpm, "extend_frames": frames, "extend_sec": round(frames / fps, 4),
                       "new_editorial_sec": round(ed + frames / fps, 4), "at": at, "note": note})
    return out, report


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--pack", required=True)
    ap.add_argument("--story", required=True)
    ap.add_argument("--raw", required=True)
    ap.add_argument("--langs", default="en,hi,mr")
    ap.add_argument("--beats", default="")
    ap.add_argument("--write", action="store_true")
    a = ap.parse_args(argv)
    rows = json.loads((Path(a.pack) / "shots.json").read_text(encoding="utf-8"))
    h3 = json.loads(Path(a.story).read_text(encoding="utf-8"))["episodes"][0]["shots"]
    beats = {k: float(v) for k, v in (x.split(":") for x in a.beats.split(",") if x)}
    langs = a.langs.split(",")
    shared, report = plan(rows, h3, a.raw, langs, beats)
    for x in report:
        print(json.dumps(x, ensure_ascii=False))
    total = sum(float(r["editorial_duration_sec"]) for r in rows) + sum(v["extend_frames"] for v in shared.values()) / 24
    print(f"total {total:.3f} s")
    if a.write:
        doc = {"fps": 24, "shared_timeline": True, "beats_bpm": beats, "max_voice_speedup": MAX_SPEEDUP, "plan": report,
               "by_lang": {lg: shared for lg in langs}}
        (Path(a.pack) / FILE).write_text(json.dumps(doc, indent=1, ensure_ascii=False), encoding="utf-8")
        print("written", Path(a.pack) / FILE)
    return 0


if __name__ == "__main__":
    sys.exit(main())
"""Anime reel ElevenLabs speech runner (copied from GranthStudio scripts/source/a1_eleven.py; only plan loading, languages en/hi/mr and paths changed) (DRAFT; nothing is validated until the owner has listened).
  voices   : free read-only list of the voices the account can use (name, id, labels)
  jobs     : prints the job list and the credit estimate for a set of line ids (no network)
  run      : generates the clips. NEEDS --allow-paid. Reuses every already-accepted clip (same text, language, voice, model, settings): a re-run buys nothing twice.
  measured : writes canon/audio/A1_eleven_measured.json (durations re-measured from the audio) for `a1_audio.py build --measured`
The API key is read at run time from the env var ELEVENLABS_API_KEY or from the first file in D:/aai work/secrets/elevenlabs; it is never printed, logged or written.
Wording: the owner's EASY script (docs/pilot/A1_full_script_simple.md) by default; --wording original = the verse text of the audio plan. The voice map is
canon/audio/A1_eleven_voices.json: {"mr": {"narrator": "<voice_id>", ...}, "hi": {...}}. Each job's key = sha256(language|voice id|model|settings|text); a clip file is named after it,
so changing any of those makes a NEW clip and never overwrites an accepted one."""
from __future__ import annotations

import argparse
import hashlib
import importlib.util
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

import re

ROOT = Path(__file__).resolve().parents[1]
LANGS = ("en", "hi", "mr")
FLOW = Path("D:/aai work/flow_outputs")


def paths(pack: Path) -> tuple:
    """Universal layout, nothing story-specific in code. pack = <root>/stories/<story>/<pack>.
    cast = <story>/voices_cast.json (ONE voice per character per language for the whole story, every reel reuses it);
    out = flow_outputs/anime_<story>/voices/<pack> (clips, manifest, measured, wavs of that reel)."""
    pack = Path(pack)
    return pack.parent / "voices_cast.json", FLOW / f"anime_{pack.parent.name}" / "voices" / pack.name


class voices:                                                                                # copied from GranthStudio a1_voices.prep_text, unchanged
    @staticmethod
    def prep_text(text: str) -> str:
        t = text.replace(chr(0x2019), "'").replace(chr(0x2018), "'").replace(chr(0x201c), "").replace(chr(0x201d), "").replace('"', "")
        t = re.sub(r"(?<![A-Za-z])'|'(?![A-Za-z])", "", t)                                  # CHANGED from Granth: an apostrophe between letters stays (Kamadeva's, don't); quote marks go
        t = re.sub(r"\s*\u0964\s*(?=\S)", ", ", t)
        t = re.sub(r"\s*\u0964\s*$", ".", t)
        t = re.sub(r"\s*,\s*,", ",", t)
        t = " ".join(t.split())
        return t if re.search(r"[.?!]$", t) else t + "."


API = "https://api.elevenlabs.io"
SECRETS = Path("D:/aai work/secrets/elevenlabs")
LEDGER = FLOW / "eleven_ledger.jsonl"                                                       # ONE ledger for the whole account: credits are shared by every story
TEST_LINES = []                                                                              # the owner-approved test set is passed with --lines (real script lines incl. hard names)
DEFAULT_CAP = 400                                                                           # credits for the first test; the full run passes --cap 3000
SETTINGS = {}                                                                               # voice settings sent with every request (empty = the voice's own defaults); part of the job key


def api_key() -> str:
    k = os.environ.get("ELEVENLABS_API_KEY", "").strip()
    if not k and SECRETS.is_dir():
        for p in sorted(SECRETS.iterdir()):
            if p.is_file():
                k = p.read_text(encoding="utf-8", errors="ignore").strip()
                break
    if len(k) < 16:
        raise SystemExit("NOT_RUN: no ElevenLabs key (set ELEVENLABS_API_KEY or put one file in D:/aai work/secrets/elevenlabs)")
    return k


def load_plan(pack: Path) -> dict:
    """The only new part: the plan comes from the pack's shots.json instead of A1_audio_plan.json. One line per narration or dialogue entry,
    id SHOT-nnn-N (narration) or SHOT-nnn-Dk (dialogue k); voice = NARRATOR or the speaker; text in en/hi/mr. A language missing for a line is an error."""
    shots = json.loads((pack / "shots.json").read_text(encoding="utf-8"))
    lines = []
    for s in shots:
        a, sid = s["audio_and_dialogue_track"], s["id"]
        if a["narration_by_lang"].get("en", {}).get("text"):
            lines.append({"id": f"{sid}-N", "voice": "NARRATOR", **{lg: a["narration_by_lang"][lg]["text"] for lg in LANGS}})
        for k, d in enumerate(a["dialogue_by_lang"]["en"], 1):
            lines.append({"id": f"{sid}-D{k}", "voice": d["speaker"].replace("CHAR-", ""),
                          **{lg: a["dialogue_by_lang"][lg][k - 1]["text"] for lg in LANGS}})
    return {"lines": lines}


def job_key(lang: str, voice_id: str, model: str, text: str, settings: dict | None = None) -> str:
    return hashlib.sha256(json.dumps([lang, voice_id, model, settings or SETTINGS, text], ensure_ascii=False).encode("utf-8")).hexdigest()


def build_jobs(plan: dict, ids: list, vmap: dict, model: str, models: dict | None = None, line_speed: dict | None = None) -> list:
    """models = optional {lang: {speaker: model_id}}: a voice that is only verified for a language on another model (e.g. Hindi on eleven_multilingual_v2) gets that model; every other line uses `model`."""
    by = {l["id"]: l for l in plan["lines"]}
    missing = [i for i in ids if i not in by]
    if missing:
        raise SystemExit(f"unknown line ids: {missing}")
    jobs = []
    for i in ids:
        l = by[i]
        for lang in LANGS:
            vid = (vmap.get(lang) or {}).get(l["voice"])
            if not vid:
                raise SystemExit(f"no voice id for {lang}/{l['voice']} in the voice map")
            text = voices.prep_text(l[lang])
            mdl = ((models or {}).get(lang) or {}).get(l["voice"], model)
            spd = (line_speed or {}).get(f"{i}.{lang}")
            st = {"speed": spd} if spd else dict(SETTINGS)                           # speed is part of the job key: a new speed is a NEW clip, an old accepted clip is never overwritten
            jobs.append({"id": f"{i}.{lang}", "line": i, "lang": lang, "voice": l["voice"], "voice_id": vid, "model": mdl, "text": text,
                         "text_sha256": hashlib.sha256(text.encode("utf-8")).hexdigest(), "credits": len(text), "settings": st, "key": job_key(lang, vid, mdl, text, st)})
    return jobs


class Ledger:
    """Append-only credit ledger: reserve the estimate BEFORE a call (under a file lock, so two processes cannot both pass the cap), settle after;
    refuses past the cap or while any reservation is open. `confirmed` = the cost came from the API's own report, not from our estimate."""
    def __init__(self, path: Path, cap: int):
        self.path, self.cap = path, cap

    def rows(self) -> dict:
        out = {}
        if self.path.exists():
            for ln in self.path.read_text(encoding="utf-8").splitlines():
                r = json.loads(ln)
                out[r["id"]] = r
        return out

    def committed(self) -> int:
        return sum(r["credits"] for r in self.rows().values())

    def unconfirmed(self) -> int:
        return sum(1 for r in self.rows().values() if r["state"] == "SETTLED" and not r.get("confirmed"))

    def _add(self, r: dict):
        self.path.parent.mkdir(parents=True, exist_ok=True)
        with open(self.path, "a", encoding="utf-8") as f:
            f.write(json.dumps(r) + "\n")

    def _lock(self):
        lock = self.path.with_suffix(".lock")
        lock.parent.mkdir(parents=True, exist_ok=True)
        for _ in range(100):
            try:
                return os.open(str(lock), os.O_CREAT | os.O_EXCL | os.O_RDWR), lock
            except FileExistsError:
                try:
                    if time.time() - lock.stat().st_mtime > 60:                  # a crashed process left it behind
                        lock.unlink(missing_ok=True)
                except FileNotFoundError:
                    pass
                time.sleep(0.1)
        raise SystemExit("the credit ledger is locked by another run")

    def reserve(self, jid: str, credits: int):
        fd, lock = self._lock()
        try:
            if any(r["state"] == "RESERVED" for r in self.rows().values()):
                raise SystemExit("an earlier reservation is still open: check the ElevenLabs usage page, then settle it by hand")
            if self.committed() + credits > self.cap:
                raise SystemExit(f"credit cap {self.cap} would be exceeded ({self.committed()} used + {credits})")
            self._add({"id": jid, "state": "RESERVED", "credits": credits, "t": time.time()})
        finally:
            os.close(fd)
            lock.unlink(missing_ok=True)

    def settle(self, jid: str, credits: int, confirmed: bool):
        self._add({"id": jid, "state": "SETTLED", "credits": credits, "confirmed": confirmed, "t": time.time()})


def http(method: str, path: str, key: str, body: dict | None = None, timeout: int = 120):
    req = urllib.request.Request(API + path, method=method, data=None if body is None else json.dumps(body).encode(),
                                 headers={"xi-api-key": key, "Content-Type": "application/json", "Accept": "*/*"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.read(), dict(r.headers)
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"HTTP {e.code}: {e.read()[:200].decode('utf-8', 'ignore')}") from None


def probe_seconds(path: Path) -> float:
    """Decoded duration of the clip (ffprobe); an undecodable file raises."""
    out = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", str(path)], capture_output=True, text=True, timeout=60)
    if out.returncode != 0 or not out.stdout.strip():
        raise RuntimeError(f"the audio does not decode: {out.stderr.strip()[:120]}")
    return float(out.stdout.strip())


def sha256_file(p: Path) -> str:
    return hashlib.sha256(p.read_bytes()).hexdigest()


def _save(man: dict, path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(man, ensure_ascii=False, indent=1), encoding="utf-8")
    os.replace(tmp, path)


def run(jobs: list, out: Path, cap: int, key: str, post=http, ledger: Ledger | None = None, probe=probe_seconds) -> dict:
    led = ledger or Ledger(LEDGER, cap)
    mpath = out / "eleven_manifest.json"
    prev = json.loads(mpath.read_text(encoding="utf-8")) if mpath.exists() else {"lines": []}
    rows = {r["key"]: r for r in prev["lines"] if r.get("ok") and r.get("key") and (out / r["file"]).exists() and sha256_file(out / r["file"]) == r["mp3_sha256"]}      # accepted clips are reused, never re-bought
    reused = 0
    failed = None
    for j in jobs:
        if j["key"] in rows:
            reused += 1
            continue
        row = {k: j[k] for k in ("id", "line", "lang", "voice", "voice_id", "model", "text", "text_sha256", "key", "settings")}
        f = out / "mp3" / j["lang"] / f"{j['id']}.{j['key'][:10]}.mp3"
        jid = f"{j['id']}#{time.time_ns()}"                                   # unique per attempt, so a re-take never overwrites an earlier charge
        led.reserve(jid, j["credits"])
        try:
            data, hdr = post("POST", f"/v1/text-to-speech/{j['voice_id']}?output_format=mp3_44100_128", key, {"text": j["text"], "model_id": j["model"], **({"voice_settings": j["settings"]} if j.get("settings") else {})})
            h = {k.lower(): v for k, v in hdr.items()}
            confirmed = "character-cost" in h
            used = int(h["character-cost"]) if confirmed else j["credits"]
            f.parent.mkdir(parents=True, exist_ok=True)
            f.write_bytes(data)
            secs = probe(f)                                                      # a 200 reply is not audio until it decodes
            if not 0.3 <= secs <= 90:
                raise RuntimeError(f"implausible duration {secs:.2f} s")
            led.settle(jid, used, confirmed)
            row.update(ok=True, file=str(f.relative_to(out)).replace("\\", "/"), mp3_sha256=sha256_file(f), seconds=round(secs, 3), credits_used=used, credits_confirmed=confirmed)
            rows[j["key"]] = row
            _save({"status": "DRAFT, NOT VALIDATED until the owner has listened", "lines": list(rows.values())}, mpath)      # checkpoint after every clip
        except RuntimeError as exc:                                          # the reservation stays open: the owner must look at the usage page
            row.update(ok=False, error=str(exc).replace(key, "[key]"))
            failed = row
            break
    man = {"status": "DRAFT, NOT VALIDATED until the owner has listened", "lines": list(rows.values()) + ([failed] if failed else []), "ok": len(rows), "reused": reused,
           "credits_committed": led.committed(), "credits_unconfirmed_clips": led.unconfirmed()}
    _save(man, mpath)
    return man


def measured(man: dict, plan: dict, script_sha256: str, model: str) -> dict:
    """The measured-durations file in the shape a1_audio.py expects, from the accepted clips of a run: every line of the plan needs a clip in both languages."""
    clips = {}
    for r in latest_ok(man):
        if True:
            clips[r["id"]] = {"lang": r["lang"], "voice": r["voice"], "speaker": r["voice_id"], "seconds": r["seconds"], "mp3_sha256": r["mp3_sha256"], "text": r["text"], "key": r["key"]}
    lines, problems = {}, []
    for l in plan["lines"]:
        for lang in LANGS:
            c = clips.get(f"{l['id']}.{lang}")
            if not c:
                problems.append(f"{l['id']}.{lang}: no accepted clip")
            elif c["voice"] != l["voice"]:                                   # a take in another voice never counts (owner 2026-11-01: speaker changes)
                problems.append(f"{l['id']}.{lang}: clip voice {c['voice']} but the plan says {l['voice']}")
            else:
                lines.setdefault(l["id"], {})[lang] = c["seconds"]
    return {"status": "MEASURED from ElevenLabs speech (DRAFT voices, NOT VALIDATED until the owner has listened)", "engine": "elevenlabs", "model": model, "script_sha256": script_sha256,
            "problems": problems, "clips": clips, "lines": lines}


def latest_ok(man: dict) -> list:
    """One accepted clip per line id: the NEWEST one (a re-generated line with new text or speed replaces the earlier clip in the mix; the earlier file stays on disk)."""
    d = {}
    for r in man["lines"]:
        if r.get("ok"):
            d[r["id"]] = r
    return list(d.values())


MAX_TEMPO = 1.15                                                                            # local speed-up limit (owner 2026-11-09: up to about 20 pct is acceptable; texts are sized for 1.08); the accepted mp3 is never modified
TRIM = "silenceremove=start_periods=1:start_threshold=-45dB,areverse,silenceremove=start_periods=1:start_threshold=-45dB,areverse"      # cuts only the silence at both ends of the wav copy


def load_slots(pack: Path, windows: Path | None = None) -> dict:
    """{line id: slot seconds} from the pack: the time window each line owns in its shot.
    windows = optional FINAL_TEXT_v2.json ({"<line>.<lang>": {"window_s": ..}}): the audio window (free time inside the shot) replaces the scripted speaking window."""
    out = {}
    for s in json.loads((pack / "shots.json").read_text(encoding="utf-8")):
        a = s["audio_and_dialogue_track"]
        if a["narration_by_lang"]["en"].get("text"):
            t = a["narration_by_lang"]["en"]["time_range"]
            out[s["id"] + "-N"] = t[1] - t[0]
        for k, d in enumerate(a["dialogue_by_lang"]["en"], 1):
            out[s["id"] + "-D" + str(k)] = d["time_range"][1] - d["time_range"][0]
    if windows and Path(windows).exists():
        for k, v in json.loads(Path(windows).read_text(encoding="utf-8")).items():
            out[k.rsplit(".", 1)[0]] = v["window_s"]
    return out


def fit_report(man: dict, slots: dict) -> list:
    """One row per accepted clip: measured seconds, slot, tempo needed (>1 = too long), verdict. A too-long clip is fitted locally up to MAX_TEMPO; beyond that it is reported, never regenerated."""
    rows = []
    for r in latest_ok(man):
        if True:
            slot = slots[r["line"]]
            tempo = max(1.0, r["seconds"] / slot)
            rows.append({"id": r["id"], "seconds": r["seconds"], "slot": round(slot, 2), "tempo": round(tempo, 3), "verdict": "fits" if tempo == 1.0 else ("fit by atempo" if tempo <= MAX_TEMPO else "TOO LONG: owner decision")})
    return rows


def export_wavs(man: dict, out: Path, wav_dir: Path, model: str, rate: int = 44100, slots: dict | None = None, report: list | None = None) -> int:
    """Decode every accepted clip to mono 16-bit wav named <line>.<lang>.wav (the layout a1_voice.py mix reads), edge silence cut (TRIM); with slots, a clip longer than its slot
    (measured on the trimmed wav) is sped up by at most MAX_TEMPO in the wav copy. report (a list) receives one row per clip: trimmed seconds, slot, tempo, verdict."""
    n = 0
    for r in latest_ok(man):
        dst = wav_dir / "wav" / r["lang"] / f"{r['id']}.wav"
        dst.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(["ffmpeg", "-y", "-v", "error", "-i", str(out / r["file"]), "-ac", "1", "-ar", str(rate), "-sample_fmt", "s16", "-af", TRIM, str(dst)], check=True)
        if slots:
            secs, slot = probe_seconds(dst), slots[r["line"]]
            tempo = max(1.0, secs / slot)
            if 1.0 < tempo <= MAX_TEMPO:
                tmp = dst.with_name(dst.stem + ".fit.wav")
                subprocess.run(["ffmpeg", "-y", "-v", "error", "-i", str(dst), "-af", f"atempo={tempo:.4f}", str(tmp)], check=True)
                os.replace(tmp, dst)
            if report is not None:
                report.append({"id": r["id"], "seconds": round(secs, 2), "slot": round(slot, 2), "tempo": round(tempo, 3),
                               "verdict": "fits" if tempo == 1.0 else ("fit by atempo" if tempo <= MAX_TEMPO else "TOO LONG: owner decision")})
        n += 1
    return n


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("voices").add_argument("--pack", default=str(ROOT))
    ex = sub.add_parser("export")
    ex.add_argument("--pack", required=True)
    ex.add_argument("--out")
    ex.add_argument("--wav-dir")
    ex.add_argument("--model", default="eleven_v4")
    for n in ("jobs", "run", "measured"):
        p = sub.add_parser(n)
        p.add_argument("--lines", default=",".join(TEST_LINES) if n != "measured" else "ALL")
        p.add_argument("--model", default="eleven_v4", help="eleven_v4 or eleven_v3 (both support hi and mr, x1.0)")
        p.add_argument("--voices", help="default <story>/voices_cast.json = {lang: {SPEAKER: voice_id}}")
        p.add_argument("--pack", required=True, help="<root>/stories/<story>/<pack>")
        if n in ("run", "measured"):
            p.add_argument("--out")
        if n == "run":
            p.add_argument("--allow-paid", action="store_true")
            p.add_argument("--cap", type=int, default=DEFAULT_CAP)
            p.add_argument("--only-voices", help="comma list of voice ids: only their clips (used while the voice slots are rotated)")
        if n == "measured":
            p.add_argument("--to")
    a = ap.parse_args()
    cast, out = paths(Path(a.pack))
    a.out = getattr(a, "out", None) or str(out)
    a.voices = getattr(a, "voices", None) or str(cast)
    a.wav_dir = getattr(a, "wav_dir", None) or str(Path(a.out) / "wav_export")
    a.to = getattr(a, "to", None) or str(Path(a.out) / "eleven_measured.json")
    if a.cmd in ("jobs", "run") and not a.lines:
        raise SystemExit("pass --lines (comma list of line ids, or ALL): there is no default set, so nothing is bought by accident")
    if a.cmd == "voices":
        data, _ = http("GET", "/v1/voices", api_key())
        for v in json.loads(data)["voices"]:
            print(v["voice_id"], "|", v["name"], "|", v.get("labels"))
        return 0
    if a.cmd == "export":
        man = json.loads((Path(a.out) / "eleven_manifest.json").read_text(encoding="utf-8"))
        slots = load_slots(Path(a.pack), Path(a.out) / "FINAL_TEXT_v2.json")
        rep = []
        print(export_wavs(man, Path(a.out), Path(a.wav_dir), a.model, slots=slots, report=rep), "wavs ->", a.wav_dir)
        Path(a.out, "fit_report.json").write_text(json.dumps(rep, indent=1), encoding="utf-8")
        for r in rep:
            if r["verdict"] != "fits":
                print(r)
        return 0
    plan = load_plan(Path(a.pack))
    if a.cmd == "measured":
        man = json.loads((Path(a.out) / "eleven_manifest.json").read_text(encoding="utf-8"))
        res = measured(man, plan, hashlib.sha256((Path(a.pack) / "shots.json").read_bytes()).hexdigest(), a.model)
        Path(a.to).write_text(json.dumps(res, ensure_ascii=False, indent=1), encoding="utf-8")
        print(f"{len(res['clips'])} clips, {len(res['problems'])} problems -> {a.to}")
        return 0 if not res["problems"] else 1
    ids = [l["id"] for l in plan["lines"]] if a.lines == "ALL" else a.lines.split(",")
    cast = json.loads(Path(a.voices).read_text(encoding="utf-8"))
    jobs = build_jobs(plan, ids, cast, a.model, cast.get("_models"), cast.get("_line_speed"))
    if getattr(a, "only_voices", None):
        keep = set(a.only_voices.split(","))
        jobs = [j for j in jobs if j["voice_id"] in keep]
    print(f"{len(jobs)} clips, about {sum(j['credits'] for j in jobs)} credits (an estimate: the API reports the real cost)")
    if a.cmd == "jobs":
        return 0
    if not a.allow_paid:
        raise SystemExit("this spends ElevenLabs credits: add --allow-paid")
    man = run(jobs, Path(a.out), a.cap, api_key())
    print(json.dumps({k: man[k] for k in ("ok", "reused", "credits_committed", "credits_unconfirmed_clips")}), "all ok" if man["ok"] >= len(jobs) else "STOPPED: see the manifest")
    return 0 if man["ok"] >= len(jobs) else 1


if __name__ == "__main__":
    sys.exit(main())
